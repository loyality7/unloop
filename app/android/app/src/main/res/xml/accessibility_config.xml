<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal on purpose. canPerformGestures is needed only for the Facebook tab tap fallback.
     canTakeScreenshot: only to read the app's own background colour next to a hidden button, so the cover
     matches it. The pixels are sampled in memory and never stored or sent. No key filtering. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/accessibility_description"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="10"
    android:accessibilityFlags="flagReportViewIds|flagIncludeNotImportantViews|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:canTakeScreenshot="true" />
